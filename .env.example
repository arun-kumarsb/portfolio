# Database Connection (Aiven MySQL / Local MySQL)
DB_URL=jdbc:mysql://localhost:3306/portfolio_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Admin Security Credentials
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=adminpassword123

# JWT Token Secret (Must be at least 32 characters long)
APP_JWT_SECRET=ArunPortfolioSecureJwtSecretKeyForSpringSecurityAuthentication2026!
